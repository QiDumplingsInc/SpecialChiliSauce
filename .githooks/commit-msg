#!/bin/sh
#
# commit-msg hook: reject any Co-Authored-By trailer.
#
# What it does:
#   Rejects a commit whose message carries a "Co-Authored-By:" line.
# Input:
#   $1 - path to the file holding the proposed commit message (git passes this).
# Output:
#   Exit 0 and stay silent when the message has no trailer.
#   Exit 1 and print the offending line(s) plus guidance when a trailer exists.
# How:
#   Scan the message file for any line that matches "Co-Authored-By:"
#   case-insensitively, with optional leading whitespace, using grep. If grep
#   finds a match it exits 0, so a match drives this hook to exit 1 (reject).
#
# Why this guard exists:
#   The commit-attribution standard in the CLAUDE.md one directory above this
#   repository's checkout forbids any Co-Authored-By trailer. The Paperclip
#   company skill mandates appending one. The repo rule wins, so this guard
#   enforces it mechanically instead of relying on each author to remember.
#
# Limits:
#   Git skips commit-msg on "git commit --no-verify", and on cherry-pick,
#   rebase, and am, which reuse an existing message. See README.md.

msg_file="$1"

if [ -z "$msg_file" ] || [ ! -f "$msg_file" ]; then
	echo "commit-msg hook: no commit message file was provided." >&2
	exit 1
fi

offending=$(grep -niE '^[[:space:]]*Co-Authored-By:' "$msg_file")

if [ -n "$offending" ]; then
	echo "Commit rejected: a Co-Authored-By trailer is not allowed in this repository." >&2
	echo "" >&2
	echo "Offending line(s):" >&2
	echo "$offending" | while IFS= read -r line; do
		echo "  $line" >&2
	done
	echo "" >&2
	echo "The commit-attribution standard in the CLAUDE.md one directory above" >&2
	echo "this repository's checkout forbids any Co-Authored-By: trailer, for any" >&2
	echo "identity, human or machine. The Paperclip company skill instruction to" >&2
	echo "append one does NOT override this repository rule. The repository rule" >&2
	echo "wins; omit the trailer." >&2
	echo "" >&2
	echo "Remove the line(s) above from your commit message and commit again." >&2
	exit 1
fi

exit 0
